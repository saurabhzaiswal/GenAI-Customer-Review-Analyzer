# -----------------------------------------------------------------------------
# GenAI Customer Review Analyzer - Backend Environment Variables
# Copy this file to `.env` in the `backend/` folder and fill in real values.
# All variables here are read by app/core/config.py (pydantic-settings).
# -----------------------------------------------------------------------------

# --- Application ---
APP_NAME=GenAI Customer Review Analyzer
APP_VERSION=0.1.0
# Used for CORS: the origin your Angular frontend is served from.
APP_URL=http://localhost:4200
DEBUG=true

# --- Database (PostgreSQL) ---
# psycopg (v3) driver. SQLAlchemy engine is created directly from this URL.
# Example (local): postgresql+psycopg://review_user:password123@localhost:5432/genai_review_analyzer
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/customer_review_analyzer

# --- AI Provider ---
# One of: gemini | openai | claude 
AI_PROVIDER=gemini

# API key for whichever provider you selected above.
AI_API_KEY=your_api_key_here

# Model name passed straight through to the provider SDK.
# Gemini:  gemini-2.5-flash (recommended) or gemini-2.5-flash-lite
# OpenAI:  gpt-4o-mini (or any Responses-API-compatible model)
AI_MODEL=gemini-3.5-flash


